/* UFARM-3845: layout corrections on top of the original Figma stylesheet. */
:root { --page-gap: clamp(20px, 3vw, 40px); }
@view-transition { navigation: auto; }
.native-motion .hero-content, .native-motion .event-card, .native-motion .directory-card { animation: none; }
body { overflow-wrap: break-word; }
.nav-shell { gap: 24px; }
.nav-links { gap: clamp(16px, 2vw, 28px); align-items: stretch; flex-shrink: 0; }
.nav-links > a { white-space: nowrap; font-size: 13px; }
.nav-actions { flex-shrink: 0; }
.wallet-link { display: flex; align-items: center; justify-content: center; gap: 7px; min-height: 40px; padding: 0 10px; color: #c7b3f8; font-size: 12px; border: 1px solid #393046; border-radius: 10px; }
.wallet-link span { display: none; }
.lang-form { display: flex; align-items: center; gap: 4px; }
.js-enabled .lang-form button { display: none; }
.nav-help { display: flex; position: relative; align-content: center; font-size: 13px; color: var(--muted); }
.nav-help summary { cursor: pointer; display: flex; align-items: center; gap: 5px; min-height: 44px; list-style: none; font-weight: 600; }
.nav-help summary::-webkit-details-marker { display: none; }
.nav-help summary .icon { width: 13px; transition: transform .2s ease; }
.nav-help[open] summary .icon { transform: rotate(180deg); }
.nav-help[data-active], .nav-help[open] { color: white; }
.help-menu { position: absolute; right: -18px; top: calc(100% - 8px); padding: 8px; min-width: 210px; background: #191920; border: 1px solid #363641; border-radius: 12px; box-shadow: 0 16px 40px #0007; }
.help-menu a { display: block; border-radius: 7px; padding: 12px; color: #b7b7c4; }
.help-menu a:hover, .help-menu a[aria-current] { background: #8b5cf61f; color: #e3d8ff; }
summary:focus-visible { outline: 2px solid #b396ff; outline-offset: 3px; border-radius: 5px; }
.hero { min-height: 680px; height: auto; padding-bottom: 85px; }
.hero-content { padding-top: 110px; }
.hero h1 { max-width: 850px; font-size: clamp(48px, 6.2vw, 84px); text-wrap: balance; }
.hero-content > p { max-width: 530px; }
.hero .live-dot { white-space: normal; }
.event-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: stretch; }
.event-card { min-width: 0; }
.event-card-body { grid-template-columns: 44px minmax(0, 1fr); gap: 10px; }
.date-block { padding-right: 5px; }
.event-copy h3 { white-space: normal; line-height: 1.35; min-height: 2.7em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.event-copy p { min-height: 1.4em; }
.event-copy small { white-space: normal; line-height: 1.5; }
.event-card .price { grid-column: 2; margin-top: 3px; flex-wrap: wrap; }
.event-card .price b { font-size: 13px; }
.section-title { gap: 20px; align-items: end; }
.section-title > a { flex-shrink: 0; }
.detail-visual { overflow: hidden; isolation: isolate; }
.detail-visual > img { display: block; object-position: center 40%; }
.detail-layout { grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(28px, 5vw, 70px); }
.detail-main h1 { overflow-wrap: anywhere; text-wrap: balance; line-height: 1.06; }
.detail-facts > div, .detail-facts p { min-width: 0; }
.detail-facts > div > span { flex-shrink: 0; }
.booking-card { min-width: 0; }
.seat-layout, .checkout-layout { grid-template-columns: minmax(0, 1fr) 360px; gap: var(--page-gap); }
.flow-header h1 { text-wrap: balance; }
.order-card, .selection-card { min-width: 0; }
.seat-row { min-width: max-content; }
.seat-map > section { padding-bottom: 15px; }
.form-card { min-width: 0; }
.favorite-list > a > div { flex: 1; min-width: 0; }
.profile-grid { align-items: start; }
.profile-grid > section > h2 { font-size: 24px; margin-bottom: 22px; }
.favorite-list > a > div p { font-size: 12px; color: var(--muted); margin-top: 6px; }
.directory-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
.directory-card { min-width: 0; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); padding: 18px; transition: border-color .2s, transform .25s; }
.directory-image { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 50%; background: #211c32; }
.directory-image img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; display: block; transition: transform .5s ease; }
.portrait-placeholder { display: grid; place-items: center; color: #cfbcff; background: radial-gradient(circle at 30% 20%, #594080, #191423 75%); border: 1px solid #70549a55; }
.portrait-placeholder > span { font: 500 clamp(48px, 6vw, 80px) 'Space Grotesk', sans-serif; }
.directory-copy { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 20px; }
.directory-copy > div { min-width: 0; }
.directory-copy h2 { font-size: 17px; line-height: 1.4; }
.directory-copy p { font-size: 12px; color: var(--muted); margin-top: 6px; }
.directory-copy > .icon { color: #b99bed; }
.directory-venues .directory-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.directory-venues .directory-image { border-radius: 12px; aspect-ratio: 16 / 10; }
.portrait-placeholder > .icon { width: 56px; height: 56px; }
.venue-placeholder { position: absolute; inset: 0; display: grid; place-items: center; background: radial-gradient(ellipse at top, #47365b, #15111d); }
.venue-placeholder > .icon { width: 70px; height: 70px; opacity: .4; color: #b59ad8; }
.support-layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 50px; align-items: start; }
.support-nav { display: grid; gap: 6px; padding: 12px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); }
.support-nav a { padding: 14px; border-radius: 8px; color: var(--muted); font-size: 14px; }
.support-nav a[aria-current] { background: #8b5cf626; color: #d4c2ff; }
.support-layout .prose p { margin-bottom: 24px; }
.support-layout .prose .primary { display: inline-flex; margin-top: 12px; }
.newsletter form { height: 46px; padding-right: 4px; }
.newsletter button { width: 36px; height: 36px; background: var(--violet); border-radius: 7px; color: white; }
.footer-grid p, .footer-grid a { font-size: 12px; line-height: 1.6; }
.footer-grid { gap: 35px; }

@keyframes enter-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
@keyframes menu-enter { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: no-preference) {
  .hero-content, .page-heading, .flow-header { animation: enter-up .6s ease-out backwards; }
  .event-card, .directory-card { animation: enter-up .45s ease-out backwards; }
  .event-card:nth-child(2), .directory-card:nth-child(2) { animation-delay: .06s; }
  .event-card:nth-child(3), .directory-card:nth-child(3) { animation-delay: .12s; }
  .event-card:nth-child(4), .directory-card:nth-child(4) { animation-delay: .18s; }
  .nav-help[open] .help-menu, .nav-links.open { animation: menu-enter .18s ease-out; }
  .primary, .glass-button, .category-row > a, .heart, .seat { transition: background-color .2s, border-color .2s, transform .2s, box-shadow .2s; }
  .primary:active, .heart:active { transform: scale(.97); }
}
@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .directory-card:hover { transform: translateY(-5px); border-color: #6d568f; }
  .directory-card:hover img { transform: scale(1.04); }
  .category-row > a:hover { transform: translateY(-3px); border-color: #8b5cf6; }
}
@media (max-width: 1100px) {
  .nav-shell { gap: 14px; }
  .menu-button { display: flex; }
  .nav-links { display: none; position: absolute; top: calc(100% + 8px); left: 24px; right: 24px; height: auto; padding: 12px; flex-direction: column; gap: 0; border: 1px solid #363641; border-radius: 14px; background: #17171e; box-shadow: 0 20px 40px #0008; max-height: calc(100dvh - 100px); overflow-y: auto; }
  .nav-links.open { display: flex; }
  .nav-links > a { min-height: 46px; padding: 0 14px; border-radius: 8px; }
  .nav-links > a.active { background: #8b5cf61f; }
  .nav-links > a.active::after { display: none; }
  .nav-help { display: block; }
  .nav-help summary { padding: 0 14px; justify-content: space-between; }
  .help-menu { position: static; box-shadow: none; border: 0; margin-left: 14px; background: #101015; }
  .wallet-link span { display: inline; }
}
@media (max-width: 900px) {
  .event-grid, .directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .detail-layout, .seat-layout, .checkout-layout { grid-template-columns: minmax(0, 1fr); }
  .directory-venues .directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .support-layout { grid-template-columns: 190px minmax(0, 1fr); gap: 25px; }
  .venue-grid .venue-card:last-child { display: flex; }
  .venue-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 640px) {
  .nav-shell { gap: 8px; }
  .nav-links { left: 15px; right: 15px; }
  .wallet-link { width: 36px; min-height: 36px; padding: 0; }
  .wallet-link span { display: none; }
  .profile-pill, .menu-button { width: 36px; height: 36px; }
  .logo { font-size: 15px; gap: 6px; }
  .logo-mark { width: 26px; height: 26px; }
  .hero { min-height: 620px; padding-bottom: 75px; }
  .hero-content { padding-top: 80px; }
  .hero h1 { font-size: clamp(38px, 10vw, 56px); letter-spacing: -1.8px; }
  .hero-actions { gap: 10px; }
  .hero-actions > a { padding-inline: 16px; }
  .event-grid, .listing-grid { display: grid; grid-template-columns: minmax(0, 1fr); overflow: visible; margin-right: 0; padding-right: 0; gap: 22px; }
  .event-card { min-width: 0; }
  .event-image, .listing-grid .event-image { height: auto; aspect-ratio: 4 / 3; }
  .event-card-body { grid-template-columns: 46px minmax(0, 1fr); }
  .event-copy h3 { min-height: 0; font-size: 17px; }
  .section-title h2 { font-size: 23px; }
  .section-title > a { font-size: 11px; max-width: 90px; }
  .section-title > a .icon { display: none; }
  .detail-main h1 { font-size: clamp(32px, 9vw, 46px); }
  .detail-layout { margin-top: -24px; padding-bottom: 60px; }
  .detail-facts { margin: 28px 0; }
  .directory-grid { gap: 12px; }
  .directory-card { padding: 12px; border-radius: 14px; }
  .directory-copy { padding-top: 14px; gap: 5px; }
  .directory-copy h2 { font-size: 14px; }
  .directory-copy p { font-size: 11px; }
  .directory-copy > .icon { display: none; }
  .directory-venues .directory-grid { grid-template-columns: minmax(0, 1fr); }
  .venue-grid { display: grid; grid-template-columns: minmax(0, 1fr); margin-right: 0; overflow: visible; }
  .venue-card { min-width: 0; }
  .support-layout { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .support-nav { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; padding: 6px; }
  .support-nav a { padding: 12px 7px; font-size: 11px; text-align: center; }
  .flow-header h1, .page-heading h1 { overflow-wrap: anywhere; }
}
@media (prefers-reduced-motion: reduce) {
  ::view-transition-old(root), ::view-transition-new(root) { animation: none !important; }
  *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  .event-card:hover, .event-card:hover img, .primary:hover { transform: none; }
}
