    def test_idempotency_and_repeated_payment(self):
        headers = {**self.token(), 'Idempotency-Key': str(uuid.uuid4())}
        payload = {'event': self.event.pk, 'seats': [self.seat_id]}
        first = self.context.request.post('/api/bookings/', data=payload, headers=headers)
        second = self.context.request.post('/api/bookings/', data=payload, headers=headers)
        self.assertEqual(first.status, 201)
        self.assertEqual(first.json()['id'], second.json()['id'])
        booking_id = first.json()['id']
        for _ in range(2):
            response = self.context.request.post(f'/api/bookings/{booking_id}/pay/', data={'outcome': 'approve'}, headers=headers)
            self.assertEqual(response.status, 200)
        self.assertEqual(self.db(lambda: Ticket.objects.filter(item__booking_id=booking_id).count()), 1)

