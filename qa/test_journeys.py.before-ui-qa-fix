    def db(self, function):
        # Keep ORM work outside Playwright's event-loop thread.
        def execute():
            close_old_connections()
            try:
                return function()
            finally:
                close_old_connections()
        return self.executor.submit(execute).result(timeout=20)

    def setUp(self):
        self.executor = ThreadPoolExecutor(max_workers=1)
        self.suffix = uuid.uuid4().hex[:9]
        self.case_dir = self.output / self._testMethodName
        self.case_dir.mkdir()
        self.console_errors = []
        self.server_errors = []
        video = {} if os.environ.get('QA_NO_VIDEO') else {'record_video_dir': str(self.case_dir / 'video')}
        self.context = self.browser.new_context(base_url=self.base_url, locale='uz-UZ', viewport={'width': 1440, 'height': 1000}, **video)
        self.context.tracing.start(screenshots=True, snapshots=True, sources=True)
        self.page = self.context.new_page()
        self.page.on('pageerror', lambda error: self.console_errors.append(str(error)))
        self.page.on('response', lambda response: self.server_errors.append(f'{response.status} {response.url}') if response.status >= 500 else None)
        self.user, self.admin, self.event, self.seat_id = self.db(self.seed)
        self.page.set_default_timeout(8000)

    def seed(self):
        user = User.objects.create_user('customer-' + self.suffix, password=self.password)
        admin = User.objects.create_superuser('admin-' + self.suffix, password=self.password)
        event = Event.objects.create(title='QA Live ' + self.suffix, category='music', venue='QA Venue',
                                      description='A real browser-test event in an isolated database.',
                                      starts_at=timezone.now() + timedelta(days=5), published=True)
        seats = [Seat(event=event, sector=sector, row=row, number=number, price=100000 if sector == 'A' else 200000)
                 for sector in ['A', 'VIP'] for row in ['A', 'B'] for number in range(1, 9)]
        Seat.objects.bulk_create(seats)
        return user, admin, event, event.seats.first().pk

    def tearDown(self):
        try:
            self.page.screenshot(path=str(self.case_dir / 'final.png'), full_page=True)
            self.context.tracing.stop(path=str(self.case_dir / 'trace.zip'))
        finally:
            self.context.close()
            self.executor.shutdown(wait=True)
        self.assertEqual(self.console_errors, [], 'Browser JavaScript errors')
        self.assertEqual(self.server_errors, [], 'HTTP 5xx responses')

