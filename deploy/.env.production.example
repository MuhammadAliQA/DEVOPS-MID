# Copy to deploy/.env.production on the server; never commit actual secrets.
APP_HOST=tickets.example.com
TLS_EMAIL=ops@example.com
# Required: immutable registry digest from the successful release build.
APP_IMAGE=
# Generate independent random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
PAYMENT_SECRET=
DB_PASSWORD=
